{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session_bind.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/context_checkpoint.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
